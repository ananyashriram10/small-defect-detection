# Export these variables before running the trainer. The trainer does not load .env automatically.

# Required only when /workspace/dataset is not already complete.
HF_TOKEN=
HF_DATASET_REPO=Smalldefect/SmallDefectDataseet

# Required for online Weights & Biases logging. Use WANDB_MODE=disabled otherwise.
WANDB_API_KEY=
WANDB_PROJECT=smallDefectDetection
WANDB_MODE=online

# Storage and experiment identity.
DATASET_ROOT=/workspace/dataset
BASE_DIR=/workspace/anzd_pidnet_v5_runs

# Selected single full v5 run. Other modes are optional comparisons.
METHOD=zoom_component
SHAPE_HEAD=1

# PIDNet-S ImageNet weights; supply the file before starting a paid run.
PRETRAINED=true
PRETRAINED_PATH=/workspace/pretrained/PIDNet_S_ImageNet.pth.tar
PRETRAINED_DOWNLOAD=false
PRETRAINED_MIN_CORE_COVERAGE=0.95

# v5 recipe.
SEED=42
IMG_SIZE=640
CROP_SIZE=320
BATCH_SIZE=8
MAX_EPOCHS=100
PATIENCE=30
NUM_WORKERS=4
LEARNING_RATE=0.01
MOMENTUM=0.9
WEIGHT_DECAY=0.0005
WARMUP_EPOCHS=2
POLY_POWER=0.9
GRAD_CLIP_NORM=10.0
EMA_DECAY=0.999
AUGMENT=true
SCALE_MIN=0.75
SCALE_MAX=1.5
COLOR_JITTER=0.2
DISTANCE_LOSS_WEIGHT=0.25

# Validation-only operating point.
CALIBRATE_THRESHOLD=true
CALIBRATION_MIN_SMALL_RECALL=0.60
CALIBRATE_MIN_BLOB=true
MIN_BLOB_CANDIDATES=0,8,16,32,64,128,256
