# Copy this file to the repository root as .env, edit it, then run:
#   set -a; source .env; set +a

# Required only when /workspace/dataset is not already complete.
HF_TOKEN=
HF_DATASET_REPO=Smalldefect/SmallDefectDataseet

# Required for online Weights & Biases logging. Use WANDB_MODE=disabled otherwise.
WANDB_API_KEY=
WANDB_PROJECT=smallDefectDetection
WANDB_MODE=online

# Storage and experiment identity.
DATASET_ROOT=/workspace/dataset
BASE_DIR=/workspace/anzd_pidnet_v2_runs
METHOD=zoom_component
RUN_NAME=ANZD_full_seed42

# ANZD-PIDNet v2 improvements.
V2_METRIC_LOSSES=1
FOREGROUND_DICE_WEIGHT=0.35
BOUNDARY_DICE_WEIGHT=0.20
LOVASZ_LOSS_WEIGHT=0.20
HARD_NEGATIVE_LOSS_WEIGHT=0.05
HARD_NEGATIVE_FRACTION=0.02
CALIBRATE_THRESHOLD=1
CALIBRATION_MIN=0.30
CALIBRATION_MAX=0.80
CALIBRATION_STEP=0.025
CALIBRATION_MIN_SMALL_RECALL=0.55

# Reproducible defaults.
SEED=42
IMG_SIZE=640
CROP_SIZE=320
BATCH_SIZE=8
MAX_EPOCHS=50
PATIENCE=15
NUM_WORKERS=2
